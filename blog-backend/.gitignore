# ==== Python / FastAPI ====

# 虚拟环境
.venv/
venv/
env/

# 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 环境变量（可能含数据库密码等敏感信息）
.env
.env.*

# 数据库本地文件
*.db
*.sqlite3
*.db-shm
*.db-wal

# IDE
.idea/

# 测试 / 覆盖率
.coverage
htmlcov/
.pytest_cache/

# 打包产物
*.egg-info/
dist/
build/

# ==== 运行时数据（不入库，部署时独立管理） ====

# 用户上传的图片和 EPUB 文件（体积大，部署时通过对象存储或备份管理）
uploads/

# Markdown 内容文件（运行时由管理后台写入）
content/

# JSON 数据文件（评论、说说等动态数据）
data/

# 锁文件（并发写入控制）
*.lock
