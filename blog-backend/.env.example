# 应用配置
APP_NAME="Starlit Blog API"
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# 访问令牌与刷新会话
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false

# 前端地址（OAuth 回调后跳转地址）
FRONTEND_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false

# 数据库（SQLite 开发 / PostgreSQL 部署）
DATABASE_URL=sqlite+aiosqlite:///./blog.db

# CORS 允许的前端地址
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 测试时临时放开所有来源；生产环境保持 false
CORS_ALLOW_ALL=false
TRUST_PROXY_HEADERS=false
ANALYTICS_HASH_SALT=change-analytics-salt

# 初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# GitHub OAuth
# 本地回调地址必须与 GitHub OAuth App 中填写的地址完全一致
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# 如果后端进程无法直连 GitHub，填写 HTTP/HTTPS 代理，例如 http://127.0.0.1:7890
GITHUB_HTTP_PROXY=
GITHUB_HTTP_TIMEOUT=20

# 邮箱验证：false 时注册后立即可登录；true 时注册后需要验证邮箱
REQUIRE_EMAIL_VERIFICATION=false

# SMTP（仅 REQUIRE_EMAIL_VERIFICATION=true 时需要配置）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
